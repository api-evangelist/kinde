              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create Connection.\n\n<div>\n  <code>create:connections</code>\n</div>\n"
        },
        {
