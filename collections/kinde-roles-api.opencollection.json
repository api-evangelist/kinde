            "name": "Get roles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/account_api/v1/roles",
            "params": [
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results per page. Defaults to 10 if parameter not sent."
              },
              {
                "name": "starting_after",
                "value": "",
                "type": "query",
                "description": "The ID of the role to start after."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns all roles for the user\n"
        },
