{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kinde Account API Keys Environments API",
    "version": "1"
  },
  "items": [
    {
      "info": {
        "name": "Environments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get environment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/environment",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Gets the current environment.\n\n<div>\n  <code>read:environments</code>\n</div>\n"
        },
        {
          "info": {
            "name": "List Environment Feature Flags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/environment/feature_flags",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get environment feature flags.\n\n<div>\n  <code>read:environment_feature_flags</code>\n</div>\n"
        },
        {
          "info": {
            "name": "Delete Environment Feature Flag Overrides",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/environment/feature_flags",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete all environment feature flag overrides.\n\n<div>\n  <code>delete:environment_feature_flags</code>\n</div>\n"
        },
        {
          "info": {
            "name": "Update Environment Feature Flag Override",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/environment/feature_flags/:feature_flag_key",
            "params": [
              {
                "name": "feature_flag_key",
                "value": "",
                "type": "path",
                "description": "The identifier for the feature flag."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update environment feature flag override.\n\n<div>\n  <code>update:environment_feature_flags</code>\n</div>\n"
        },
        {
          "info": {
            "name": "Delete Environment Feature Flag Override",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/environment/feature_flags/:feature_flag_key",
            "params": [
              {
                "name": "feature_flag_key",
                "value": "",
                "type": "path",
                "description": "The identifier for the feature flag."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete environment feature flag override.\n\n<div>\n  <code>delete:environment_feature_flags</code>\n</div>\n"
        },
        {
          "info": {
            "name": "Read logo details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/environment/logos",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Read environment logo details\n\n<div>\n  <code>read:environments</code>\n</div>\n"
        },
        {
          "info": {
            "name": "Add logo",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/environment/logos/:type",
            "params": [
              {
                "name": "type",
