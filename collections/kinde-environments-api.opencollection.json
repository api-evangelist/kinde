            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Add environment logo\n\n<div>\n  <code>update:environments</code>\n</div>\n"
        },
        {
          "info": {
            "name": "Delete logo",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/environment/logos/:type",
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "path",
                "description": "The type of logo to delete."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete environment logo\n\n<div>\n  <code>update:environments</code>\n</div>\n"
